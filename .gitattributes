# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Git LFS — binary assets (3D models, textures, audio)
*.glb   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.png   filter=lfs diff=lfs merge=lfs -text
*.bmp   filter=lfs diff=lfs merge=lfs -text
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.res   filter=lfs diff=lfs merge=lfs -text

# Keep these OUT of LFS — rules below must follow the LFS rules above (last match wins).
# Doc screenshots stay in normal git so they render inline in markdown.
.github/** !filter !diff !merge text=auto
# Blender autosave backups are gitignored, never LFS.
*.blend1 !filter !diff !merge
