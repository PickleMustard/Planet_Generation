[gd_scene load_steps=4 format=3 uid="uid://extraction_details"]

[ext_resource type="Script" path="res://Scripts/UI/BuildingInfo/ExtractionDetails.cs" id="1_extraction"]
[ext_resource type="PackedScene" uid="uid://recipe_display" path="res://UI/BuildingInfo/RecipeDisplay.tscn" id="2_recipe"]
[ext_resource type="PackedScene" uid="uid://donut_chart_component" path="res://UI/Components/DonutChart.tscn" id="3_donut"]

[node name="ExtractionDetails" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_extraction")

[node name="HBoxContainer" type="HBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16

[node name="LeftPanel" type="VBoxContainer" parent="HBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 0.4
theme_override_constants/separation = 8

[node name="RecipeDisplay" parent="HBoxContainer/LeftPanel" instance=ExtResource("2_recipe")]
layout_mode = 2

[node name="DescriptionLabel" type="Label" parent="HBoxContainer/LeftPanel"]
layout_mode = 2
text = "Recipe description goes here."
autowrap_mode = 3

[node name="RightPanel" type="VBoxContainer" parent="HBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 0.6
theme_override_constants/separation = 8

[node name="OutputHBox" type="HBoxContainer" parent="HBoxContainer/RightPanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="OutputIcon" type="TextureRect" parent="HBoxContainer/RightPanel/OutputHBox"]
custom_minimum_size = Vector2(24, 24)
layout_mode = 2
