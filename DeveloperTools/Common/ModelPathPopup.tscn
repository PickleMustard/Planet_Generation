[gd_scene format=3 uid="uid://qhigl5vf724c"]

[ext_resource type="Script" path="res://DeveloperTools/Common/ModelPathPopup.cs" id="1_popup"]

[node name="ModelPathPopup" type="PopupPanel" node_paths=PackedStringArray("_search", "_resultsBox", "_fileDialog")]
size = Vector2i(480, 480)
script = ExtResource("1_popup")
_search = NodePath("Root/SearchEdit")
_resultsBox = NodePath("Root/Scroll/ResultsBox")
_fileDialog = NodePath("FileDialog")

[node name="Root" type="VBoxContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
size_flags_horizontal = 3

[node name="TitleLabel" type="Label" parent="Root"]
layout_mode = 2
theme_type_variation = &"LabelHighContrast"
text = "Select Model"
horizontal_alignment = 1

[node name="SearchEdit" type="LineEdit" parent="Root"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Search models…"

[node name="Scroll" type="ScrollContainer" parent="Root"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="ResultsBox" type="VBoxContainer" parent="Root/Scroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Actions" type="HBoxContainer" parent="Root"]
layout_mode = 2
size_flags_horizontal = 3

[node name="BrowseButton" type="Button" parent="Root/Actions"]
layout_mode = 2
tooltip_text = "Wrap a loose .glb/.gltf/.tscn into a ModelConfig and anchor it"
text = "Browse raw…"

[node name="Spacer" type="Control" parent="Root/Actions"]
layout_mode = 2
size_flags_horizontal = 3

[node name="CancelButton" type="Button" parent="Root/Actions"]
layout_mode = 2
text = "Cancel"

[node name="FileDialog" type="FileDialog" parent="."]
access = 2
current_dir = "res://Mesh/external/"
filters = PackedStringArray("*.tres ; Model Wrapper (ModelConfig)", "*.glb, *.gltf, *.tscn ; Model (creates wrapper)")

[connection signal="text_changed" from="Root/SearchEdit" to="." method="OnSearchChanged"]
[connection signal="pressed" from="Root/Actions/BrowseButton" to="." method="OnBrowsePressed"]
[connection signal="pressed" from="Root/Actions/CancelButton" to="." method="OnCancelPressed"]
[connection signal="file_selected" from="FileDialog" to="." method="OnRawFileSelected"]
