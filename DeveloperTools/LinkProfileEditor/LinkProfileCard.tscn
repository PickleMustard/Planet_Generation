[node name="LinkProfileCard" type="PanelContainer"]
theme_override_styles/panel = SubResource("StyleBoxFlat_card")
script = ExtResource("1_card")

[node name="CardMainVBox" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3

[node name="HeaderHBox" type="HBoxContainer" parent="CardMainVBox"]
layout_mode = 2
size_flags_horizontal = 3

[node name="IdNameLabel" type="Label" parent="CardMainVBox/HeaderHBox"]
layout_mode = 2
text = "Id:"
theme_override_colors/font_color = Color(0.7, 0.7, 0.7, 1)

[node name="IdNameEdit" type="LineEdit" parent="CardMainVBox/HeaderHBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "id_name (lowercase_with_underscores)"

[node name="DeleteButton" type="Button" parent="CardMainVBox/HeaderHBox"]
unique_name_in_owner = true
layout_mode = 2
text = "✕"

[node name="FieldsGrid" type="GridContainer" parent="CardMainVBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 4
columns = 4

[node name="TierLabel" type="Label" parent="CardMainVBox/FieldsGrid"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.7, 0.7, 1)
text = "Tier:"

[node name="TierSpin" type="SpinBox" parent="CardMainVBox/FieldsGrid"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
max_value = 10.0

[node name="StateLabel" type="Label" parent="CardMainVBox/FieldsGrid"]
layout_mode = 2
