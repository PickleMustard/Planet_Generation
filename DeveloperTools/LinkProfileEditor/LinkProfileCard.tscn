[gd_scene load_steps=2 format=3 uid="uid://link_profile_card"]

[ext_resource type="Script" path="res://DeveloperTools/LinkProfileEditor/LinkProfileCard.cs" id="1_card"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card"]
content_margin_left = 8.0
content_margin_top = 8.0
content_margin_right = 8.0
content_margin_bottom = 8.0
bg_color = Color(0.15, 0.15, 0.18, 1)
border_width_left = 1
