layout_mode = 2
size_flags_horizontal = 3

[node name="TransportSpeedLabel" type="Label" parent="CardMainVBox/FieldsGrid"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.7, 0.7, 1)
